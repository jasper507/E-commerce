# This Dockerfile-specific allowlist leaves the existing worker context unchanged.
**
!requirements/
!requirements/base.txt
!requirements/deployment.txt
!backend/
!backend/manage.py
!backend/config/
!backend/config/*.py
!backend/apps/
!backend/apps/__init__.py
!backend/apps/accounts/
!backend/apps/catalog/
!backend/apps/inventory/
!backend/apps/ordering/
!backend/apps/payments/
!backend/apps/promotions/
!backend/apps/*/*.py
!backend/apps/*/migrations/
!backend/apps/*/migrations/*.py
!backend/apps/*/management/
!backend/apps/*/management/*.py
!backend/apps/*/management/commands/
!backend/apps/*/management/commands/*.py
!backend/apps/promotions/admission.lua

# Local credentials and generated files are never runtime source.
**/.env
**/.env.*
**/.git
**/.git/**
**/.venv
**/.venv/**
**/venv
**/venv/**
**/node_modules
**/node_modules/**
**/dist
**/dist/**
**/__pycache__
**/__pycache__/**
**/.pytest_cache
**/.pytest_cache/**
**/tests
**/tests/**
