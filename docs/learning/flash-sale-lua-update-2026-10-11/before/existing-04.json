                                  "content":  "\u003ctitle id=\"T5Asd41r4oDZWaxmxJIcJSNQnq4\"\u003e04 从付款到关闭：资格生命周期与 MQ 的业务价值\u003c/title\u003e\u003cp id=\"doxcnIqbxSBS60Bz3xeMYzKMBPc\"\u003e\u003cb\u003e付款成功要同时确认订单、核销库存并消费资格；真正未付关闭要同时释放库存与资格。MQ 把支付通知的接收与处理分开，MySQL 仍决定交易事实。\u003c/b\u003e秒杀建单目前是同步 MySQL 事务，未实施“抢购请求入队后异步建单”。\u003c/p\u003e\u003cp id=\"doxcnBcYDbni1j3GGVjjzN1se5e\"\u003e适用读者：已经理解预占和幂等，想把支付、取消和后台任务串起来的项目拥有者。读完应能回答“为什么用了 MQ 还需要恢复扫描”“旧订单的迟到付款为什么不能影响新订单”。源码基于归档提交，证据为历史隔离验收，本次未重跑。\u003c/p\u003e\u003cp id=\"doxcn7VdlddlvhNrzaji3wvOQzh\"\u003e\u003ca href=\"https://ocnbkcx1ug58.feishu.cn/wiki/WN1jwXDj0iPXm7kwLyHcmneenlb\"\u003e电商项目\u003c/a\u003e；\u003ca href=\"https://ocnbkcx1ug58.feishu.cn/wiki/B49NwtiePiCqqFkz61kc4ac9n79\"\u003e秒杀总览\u003c/a\u003e；\u003ca href=\"https://ocnbkcx1ug58.feishu.cn/wiki/AOvlwoTENiyvgok63ivct7xGnWe\"\u003e上一篇：03 下单失败：为什么整单回滚与等待 5 秒\u003c/a\u003e；\u003ca href=\"https://ocnbkcx1ug58.feishu.cn/wiki/R1Duwgh8bimIyQkdUrWcDpNAnze\"\u003e下一篇：05 响应丢失：为什么保留原购买意图\u003c/a\u003e。\u003c/p\u003e\u003ch1 id=\"doxcnSFZy7IO44UzpbkBjvCGUwb\" seq=\"auto\" seq-marker=\"1.\"\u003e业务先决定资格何时消费和返还\u003c/h1\u003e\u003cp id=\"doxcnZkRr812Y1Js0w0YoSqtH8f\"\u003e例子从库存 5/0 开始，两个数字分别是 available（可售）和 reserved（预占）。顾客下单一件后库存 4/1，订单待付，资格 HELD。支付失败与订单关闭是两种不同事件：一次付款失败，顾客仍可以在原订单上尝试付款，不能立刻把库存与资格返还给别人。\u003c/p\u003e\u003ctable id=\"doxcnMkXLeSgQmMX1jPmoUlJj30\"\u003e\u003ccolgroup\u003e\u003ccol width=\"246\"/\u003e\u003ccol width=\"246\"/\u003e\u003ccol width=\"246\"/\u003e\u003c/colgroup\u003e\u003cthead\u003e\u003ctr\u003e\u003cth vertical-align=\"top\"\u003e\u003cp id=\"doxcnYR3BzopbXhc5k5vmNWPqEJ\"\u003e业务结果\u003c/p\u003e\u003c/th\u003e\u003cth vertical-align=\"top\"\u003e\u003cp id=\"doxcnwf4VoU5hIBrkzHOWMst4Bb\"\u003e订单 / 资格\u003c/p\u003e\u003c/th\u003e\u003cth vertical-align=\"top\"\u003e\u003cp id=\"doxcn9MbKBTTLgA940jBOIwMi3c\"\u003e库存与后续购买\u003c/p\u003e\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcnszEeUc26pUmz0xaHIX61We\"\u003e正常付款成功\u003c/p\u003e\u003c/td\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcnGwkxz0CrywJPNSEIECMz2g\"\u003ePAID / CONSUMED\u003c/p\u003e\u003c/td\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcnIUaujkvycoUTBnqLrWa17g\"\u003e4/1→4/0；不再减可售；禁止新 Key 重购\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcnhaikrWbmuU4JsBRrkdbFRh\"\u003e真正未付取消或到期\u003c/p\u003e\u003c/td\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcnxkkDPycaPup91fhmN5AWEZ\"\u003eCANCELED 或 EXPIRED / RELEASED\u003c/p\u003e\u003c/td\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcnDmE6sROyiCLyt1UgIPYnJc\"\u003e4/1→5/0；允许新 Key 重新申请\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcnv6Mgk4IKJwl79DLJafgueb\"\u003eAttempt 仍 CREATED/PENDING/UNKNOWN\u003c/p\u003e\u003c/td\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcnckIftd04QHDcAg30yTRpof\"\u003e付款尚未确认；暂缓关闭\u003c/p\u003e\u003c/td\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcnn0fqyq2q1ghC6uiIKJp1Ng\"\u003e不释放，先查询原付款结果\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcnsTFAOgFvO8AGK6v7jsKgcg\"\u003e已付、未发货取消\u003c/p\u003e\u003c/td\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcnwc5uNAZYgvw5fMjqUCYeng\"\u003eCANCELED / CONSUMED\u003c/p\u003e\u003c/td\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcn9jl96yfEHvIVwZuDQdToMd\"\u003e恢复库存、模拟退款；成功购买资格不返还\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003cp id=\"doxcnl8ZkVUssJU4hj0C5fHXPnb\"\u003eUNKNOWN 是结果未知，不是付款失败。没有确认就释放，可能先允许第二张订单，再收到第一张付款成功，造成两份交易争夺一份资源。\u003c/p\u003e\u003ch1 id=\"doxcnIUw5UnKzeACnXKHBtWrhwc\" seq=\"auto\" seq-marker=\"2.\"\u003e哪些修改必须一起提交\u003c/h1\u003e\u003cp id=\"doxcnYA2gu03F9O3viCdWrhAlJh\"\u003eTransaction（事务：一组数据库修改一起成功或一起回滚）保护跨表一致。成功通知处理中，锁序为 Event → Order → Attempt → Purchase → Reservation → Inventory；真正未付关闭从 Order 开始核对 Attempt，再处理 Purchase 和库存。不是所有入口都要先锁 Event。\u003c/p\u003e\u003cpre id=\"doxcnW7IUJFncJzYAwSCa90shQg\" caption=\"成功分支核心节选：同一个业务事务\u0026#xA;\" lang=\"python\"\u003e\u003ccode\u003epurchase = lock_flash_sale_purchase(\u003cbr/\u003e    order, expected_status=FlashSalePurchase.Status.HELD\u003cbr/\u003e)\u003cbr/\u003e_commit_inventory(order)\u003cbr/\u003e# 同事务保存 Attempt SUCCEEDED、Order PAID\u003cbr/\u003etransition_flash_sale_purchase(\u003cbr/\u003e    purchase, target_status=FlashSalePurchase.Status.CONSUMED\u003cbr/\u003e)\u003cbr/\u003e# 同事务保存 Event 处理结果\u003c/code\u003e\u003c/pre\u003e\u003cp id=\"doxcn2hXwJJvWupxQXiTs0zJYUf\"\u003e节选中的注释概括了省略的保存语句。\u003ca href=\"https://github.com/jasper507/E-commerce/blob/18ffbe2f2bf674d31f3d2dc055976aedd41af010/backend/apps/payments/services.py#L365-L381\"\u003e完整成功分支\u003c/a\u003e与\u003ca href=\"https://github.com/jasper507/E-commerce/blob/18ffbe2f2bf674d31f3d2dc055976aedd41af010/backend/apps/promotions/lifecycle_services.py#L13-L52\"\u003e按原订单取锁与资格转换\u003c/a\u003e。资格更新异常时，已执行的库存、订单修改也回滚，不能留下 PAID / HELD 的半完成事实。\u003c/p\u003e\u003cp id=\"doxcnn4SzLngfuYYe0omdF2lucb\"\u003e替代方案是业务提交后再补写资格：锁少一点，却增加失败窗口和补偿责任。当前把它们放在一个 MySQL 事务内，多持有一把本单资格锁，换取直接可验证的一致性。\u003c/p\u003e\u003ch1 id=\"doxcnlDqwe2ra1gPmmYnt6bOAme\" seq=\"auto\" seq-marker=\"3.\"\u003e为什么业务需要 MQ\u003c/h1\u003e\u003cp id=\"doxcno1NODtnxX8t49oUj8qUpqd\"\u003e同步基线在 HTTP 请求里保存通知并立即处理。库存锁竞争或处理异常会拖住这次请求；进程在入箱后中断，顾客还得等网关重发或人工恢复。我们的目标是先可靠保存收到的通知，再让后台独立完成校验和业务事务。\u003c/p\u003e\u003cp id=\"doxcne87lVXS9NY6SRMAseGtYXd\"\u003eMessage Queue（消息队列，简称 MQ：在接收方与处理方之间传递待处理工作的通道）在本项目由 RabbitMQ 保存任务消息，Celery Worker（后台执行进程）读取内部 Event ID，调用已有处理入口。业务规则没有搬成第二套，消息也不包含可信付款金额或库存决策。\u003c/p\u003e\u003cwhiteboard id=\"doxcn61RlIsGPCa6ZUzWYJ3RUcd\" token=\"DmzxwwTfmh47dvbxfa9ceryvnOf\"\u003e\u003c/whiteboard\u003e\u003cp id=\"doxcnRIvLJBzhEEn0m4PqUqeiFf\"\u003e\u003c/p\u003e\u003cp id=\"doxcnq4jtaWnlsnHs67ZOHpOjVe\"\u003e图里的四个边界要分开：Inbox 提交 → 发布 ID → Worker 业务提交 → 消费确认。调用网关和等待 Broker 都在数据库事务外，不能带着订单或库存锁等待网络。\u003c/p\u003e\u003cp id=\"doxcnVjKH9ZQ0XAFZssdDwb1xGd\"\u003e\u003c/p\u003e\u003cp id=\"doxcnKmF1jfjfSv7dsmWywXXl2c\"\u003e异步 Webhook 的 202 表示原文已入箱；不是付款成功，也不是消息一定已可靠发布。ACK（消息消费确认：告诉队列本次投递已被确认）同样不能单独证明订单已付，须查 MySQL 的业务终态。\u003c/p\u003e\u003cp id=\"doxcnlWH5wbJFEmtI9UNqJRcN2d\"\u003e\u003c/p\u003e\u003ctable id=\"doxcnxukZZv1qByfqrUXbsiYC4d\"\u003e\u003ccolgroup\u003e\u003ccol width=\"204\"/\u003e\u003ccol width=\"267\"/\u003e\u003ccol width=\"267\"/\u003e\u003c/colgroup\u003e\u003cthead\u003e\u003ctr\u003e\u003cth vertical-align=\"top\"\u003e\u003cp id=\"doxcn8cjISNo7lqEmXuSLLca6rh\"\u003e方案\u003c/p\u003e\u003c/th\u003e\u003cth vertical-align=\"top\"\u003e\u003cp id=\"doxcn1wFc29hCOjLHHIwghY85Dd\"\u003e业务收益\u003c/p\u003e\u003c/th\u003e\u003cth vertical-align=\"top\"\u003e\u003cp id=\"doxcnVvC5Wpcmzpka7VgtCBBl8g\"\u003e付出的代价\u003c/p\u003e\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcnp5hUtf6sitiBTnAQceYeU4\"\u003e同步 + 人工或定时 Inbox 扫描\u003c/p\u003e\u003c/td\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcnOoc7xZViQIfgj7vPZMyBbh\"\u003e系统简单，复用一个处理器\u003c/p\u003e\u003c/td\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcnvDSvceTWu3DzvTCfvV7F3g\"\u003e请求与业务处理耦合；及时性或轮询成本要权衡\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcnoya8NeUqYaNz6AJ4ZNWepQ\"\u003e持久 Inbox + MQ 后台处理\u003c/p\u003e\u003c/td\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcnlAEIj86GQxO66NMM16Z2pe\"\u003e接收和处理分开，独立任务执行；可安排到期重试\u003c/p\u003e\u003c/td\u003e\u003ctd vertical-align=\"top\"\u003e\u003cp id=\"doxcn1eCp6PbIaZ6yc8N7QVffjc\"\u003e增加 Broker/Worker、重复投递、漏投和中断恢复责任\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003cp id=\"doxcnBbL2diwX9WBWpuoOttWnce\"\u003e\u003c/p\u003e\u003cp id=\"doxcnaMWmCDlfbUk27xa4x3JLNe\"\u003e当前默认仍同步，异步是本地开发/测试可选路径，真实 RabbitMQ 与 Worker 已有验证。尚不能声称 MQ 提高了秒杀吞吐，或天然保证“业务效果恰好一次”。秒杀库存竞争仍由 MySQL 解决。\u003ca href=\"https://github.com/jasper507/E-commerce/blob/18ffbe2f2bf674d31f3d2dc055976aedd41af010/backend/apps/payments/services.py#L583-L609\"\u003e入箱后选择同步/异步\u003c/a\u003e；\u003ca href=\"https://github.com/jasper507/E-commerce/blob/18ffbe2f2bf674d31f3d2dc055976aedd41af010/backend/apps/payments/dispatch.py#L13-L30\"\u003e事务外发布 ID\u003c/a\u003e。\u003c/p\u003e\u003cp id=\"doxcnHXV2FwIpj4yHDrPdNujJRg\"\u003e\u003c/p\u003e\u003ch1 id=\"doxcnsHOvlfMeBLtC6YodsLApmb\" seq=\"auto\" seq-marker=\"4.\"\u003e重复、暂时失败和进程中断怎样收尾\u003c/h1\u003e\u003cp id=\"doxcn8mi5piDJ4q4bzr1MU7wzog\"\u003e\u003c/p\u003e\u003cp id=\"doxcnnTDoCoO2VboUnoBjq3ejGe\"\u003e重复消息可再次到达，Event 领取资格与锁内终态判断挡住重复业务效果；不同事件指向同一成功 Attempt，也不能重复核销。MySQL 保存累计处理预算：总共 3 次包含首次，允许的暂时失败分别等待 5 秒、10 秒；未知错误、库存/资格不一致阻断调查，次数耗尽停止。Celery 不另设一份业务重试预算。\u003c/p\u003e\u003cp id=\"doxcnjtx0PobjbJfjq7Ty1QyWih\"\u003e\u003c/p\u003e\u003cp id=\"doxcnI8VWE7Q96WI1SL09jlJvgd\"\u003e提交 Inbox 后进程可能还没发布就中断，或 Broker 不可用。人工补投重新发送原 ID，允许重复，不能把 published 当成 paid。Worker 领取 PROCESSING 后硬中断，还需要持久租约：默认 60 秒，到期只是检查资格的条件，不是死亡证明。人工恢复锁内核对状态、次数版本和截止，拿不到业务锁就跳过；修复后再补投或同步处理，预算不清零。尚无无人值守恢复时限承诺。\u003c/p\u003e\u003cp id=\"doxcnMeVFbzncSbICwrnI3NtNTp\"\u003e\u003c/p\u003e\u003cp id=\"doxcn8DKUUMJsriAfGuMumDbOTc\"\u003e2026-10-05 的真实 C4 验证分别中断在领取提交后、业务未提交、业务提交后 ACK 前及退款提交后：恢复最终只核销一次或只退款一次。C3 真实停 Broker 验证提交后漏投的人工补发。这里只概括业务价值；具体命令、MQ 配置与原始过程沿用\u003ca href=\"https://ocnbkcx1ug58.feishu.cn/wiki/CDXkw84eWiDj5ZkzitPcs1PhnIh\"\u003e已有支付与 MQ 知识库\u003c/a\u003e。\u003c/p\u003e\u003cp id=\"doxcnoUB0gDa54hXLXdl02QRZ3f\"\u003e\u003c/p\u003e\u003ch1 id=\"doxcnjR1cKErSjpOoUJZbSBWXzf\" seq=\"auto\" seq-marker=\"5.\"\u003e旧订单迟到成功，不能碰新订单资格\u003c/h1\u003e\u003cp id=\"doxcnlRybH1sZOIiUgca2qMNxRh\"\u003e\u003c/p\u003e\u003cp id=\"doxcn2UYuKNnd80yxvWf8XlPIQh\"\u003eO1 真正未付关闭，资格 RELEASED 后，顾客可用 K2 创建 O2，资格 HELD。此时 O1 收到可信成功通知，系统保持 O1 关闭、只为 O1 模拟退款，不走正常库存核销，也不按“顾客当前活动资格”去改 O2。购买记录必须按 order 定位，这是保留每单历史的业务理由。\u003c/p\u003e\u003cp id=\"doxcnDqU7bfqWXkBBgfFTXhNyCf\"\u003e\u003c/p\u003e\u003cp id=\"doxcncyTXWPPSNq84qEKA0nfpKd\"\u003e2026-10-07 的 6B 验证覆盖 O1 关闭→O2 重购→旧 Key→O1 迟到成功及重复通知，O2 保持 HELD，旧单退款一次。6B 只做服务层 MySQL；其中 1205 是测试注入，不能说成真实锁超时实验。\u003ca href=\"https://github.com/jasper507/E-commerce/blob/18ffbe2f2bf674d31f3d2dc055976aedd41af010/docs/verification/phase-6b-flash-sale-lifecycle.md#L35-L62\"\u003e6B 证据和限制\u003c/a\u003e；\u003ca href=\"https://github.com/jasper507/E-commerce/blob/18ffbe2f2bf674d31f3d2dc055976aedd41af010/docs/verification/phase-5c4-payment-worker-recovery.md#L80-L93\"\u003eC4 四个真实中断窗口\u003c/a\u003e。\u003c/p\u003e\u003cp id=\"doxcn6BHOC1q6s3yDh35MoEr79g\"\u003e\u003c/p\u003e\u003cp id=\"doxcnQKE1uZOWzpi4Cfpb285nue\"\u003e\u003cb\u003e闭卷自检：\u003c/b\u003e解释“202、published、ACK、PAID”各代表什么；画出一次支付成功的同事务事实；说明 MQ 为什么还需要 Inbox 补漏，以及 O1 迟到成功为什么不能释放 O2。能结合一条真实证据说清边界，即达到本页目标。\u003c/p\u003e\u003cp id=\"doxcnNB3oySZAthJLRet2y1ExUh\"\u003e\u003c/p\u003e",
                                  "document_id":  "T5Asd41r4oDZWaxmxJIcJSNQnq4",
                                  "revision_id":  3
                              }
             }
}
