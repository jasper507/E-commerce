# Copy this file to .env only when you want to override the safe local defaults.
# Never commit .env. Blank secret values below are intentional placeholders.

DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# The Docker MySQL service is exposed only on 127.0.0.1:3307 so that it does
# not conflict with the existing native MySQL service on port 3306.
MYSQL_DATABASE=project_one
MYSQL_USER=project_one
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

# Django may create and destroy only this isolated database during tests.
MYSQL_TEST_DATABASE=test_project_one

# Used only by the local MySQL container. Set a real value outside local study.
MYSQL_ROOT_PASSWORD=

# Optional local catalog cache; test Redis uses a separate port (6381).
CATALOG_CACHE_ENABLED=false
CATALOG_CACHE_REDIS_URL=redis://127.0.0.1:6380/0
CATALOG_CACHE_KEY_PREFIX=project-one:development
CATALOG_CACHE_TTL=30
CATALOG_CACHE_TTL_JITTER=5

# Optional flash-sale attempt budget; independent from catalog cache, default off.
# All POST attempts including original-Key confirmation use the same window.
FLASH_SALE_ADMISSION_ENABLED=false
FLASH_SALE_ADMISSION_REDIS_URL=redis://127.0.0.1:6380/0
FLASH_SALE_ADMISSION_KEY_PREFIX=project-one:development
FLASH_SALE_ADMISSION_LIMIT=20
FLASH_SALE_ADMISSION_WINDOW_MS=1000

# Optional payment MQ profile; leave async disabled for the MySQL/Mock baseline.
# Run the Linux worker through the payment-mq Compose profile.
PAYMENT_EVENTS_ASYNC=false
CELERY_BROKER_URL=amqp://project_one:project-one-mq-local-only@127.0.0.1:5672/project_one
CELERY_TASK_DEFAULT_QUEUE=payments

# Compose broker credentials. Blank values use local-only example defaults.
# Use URL-safe passwords here because Compose embeds them in the AMQP URL.
PAYMENT_MQ_PASSWORD=
PAYMENT_MQ_TEST_PASSWORD=

# Isolated payment-mq-test profile uses AMQP 5673 and management API 15673.
# Test publisher overrides: DJANGO_ENV=test, MYSQL_DATABASE=test_project_one,
# PAYMENT_EVENTS_ASYNC=true, CELERY_TASK_DEFAULT_QUEUE=payment-events-test,
# CELERY_BROKER_URL=amqp://project_one_test:project-one-mq-test-only@127.0.0.1:5673/project_one_test
# Host publisher and worker must share DJANGO_SECRET_KEY for Mock HMAC checks.
